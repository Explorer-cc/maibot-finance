# 复制为 .env 后填写。此文件只包含安全占位符，.env 不会提交。
# Core、NapCat 和 sqlite-web 端口只绑定到 127.0.0.1。可选的 public-admin profile
# 在运营者明确接受明文 HTTP 风险后，仅公开 8080（MaiBot）；详见 deploy/README.md。

# 2026-08-08 从 Docker Hub 核验的 amd64 manifest digest；目标主机为 x86_64。
MAIBOT_IMAGE=sengokucola/maibot@sha256:c0d6e0430801b5c08581a3af232766ba198ae9b5c718ef0a347c39c5bb3e4c36
NAPCAT_IMAGE=mlikiowa/napcat-docker@sha256:02ddf329894887552bc6207a41e471bcf51ef0f04751804905aeb8cf1f737d4f
SQLITE_WEB_IMAGE=coleifer/sqlite-web@sha256:1e5b86237968ed747554f951c6df2fc2fe4bf4ef070b8ca23d553d7f6c6426f7
CADDY_IMAGE=caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

WEBUI_PORT=18001
NAPCAT_WEBUI_PORT=6099
SQLITE_WEB_PORT=8120

# 可选公网管理入口：仅由 scripts/start-public-admin.sh 启动，不会重启 core 或 napcat。
# 这是运营者明确接受的明文 HTTP 例外：公网 TCP 8080（MaiBot）必须可达。
PUBLIC_HTTP_PORT=8080
MAIBOT_ADMIN_USER=CHANGE_ME
# 填标准 bcrypt 哈希而非明文密码；保留哈希原有的单个 $ 字符。
MAIBOT_ADMIN_PASSWORD_HASH=CHANGE_ME

# WebUI 管理 Token：至少 20 个字符；bootstrap 会仅写入 runtime/data/MaiMBot/webui.json。
# 请使用独立随机值，绝不复用 API key、NapCat token 或 QQ 密码。
WEBUI_ACCESS_TOKEN=CHANGE_ME

# 在阅读锁定 MaiBot 1.1.4 镜像中的 EULA/隐私条款并同意后，填写下面注释给出的精确确认值。
# 不同意则保持 CHANGE_ME，启动会被阻止。镜像升级时必须重新审计这两个值。
# EULA_AGREE expected: 8e6e7d647f7f82d6ea98456b73908656
# PRIVACY_AGREE expected: 91e5db7659c560bc3545e63859b6ebc0
MAIBOT_EULA_AGREE=CHANGE_ME
MAIBOT_PRIVACY_AGREE=CHANGE_ME

# 当前运行基线必填：机器人 QQ、唯一群群号、DeepSeek key 和实际模型 ID。
BOT_QQ_ACCOUNT=CHANGE_ME
PRODUCTION_GROUP_ID=CHANGE_ME
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# NapCat 正向 WebSocket 的访问 token。请使用独立随机值（建议至少 20 字符）；bootstrap 会同时写入
# NapCat 的内部 3001 监听与 Adapter 配置。不得与两类 WebUI token、模型 key 或 QQ 密码复用。
NAPCAT_WS_TOKEN=CHANGE_ME

# NapCat 本机 WebUI 的独立管理 Token（至少 20 个字符）。bootstrap 会预置 runtime/napcat-config/webui.json。
# 绝不复用 WebUI_ACCESS_TOKEN、模型 key、WS token 或 QQ 密码。
NAPCAT_WEBUI_TOKEN=CHANGE_ME

# 当前运行基线使用 Qwen-VL 与 Qwen embedding，并启用 A_Memorix 的查询、画像注入和自动写回。
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://llm-tpdkmj8ch48u24zo.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
# 模型 ID 与维度必须以 DashScope 控制台、官方文档或实际返回为准。
# QWEN_EMBEDDING_MODEL 与 QWEN_EMBEDDING_DIMENSION 必须成对确认；变更任一项前需要全量重建索引。
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSION=CHANGE_ME

# 当前未导入静态金融资料，MCP 保持关闭；不得在本模板中添加 MCP 凭据、URL、实时数据或任何交易配置。

# 已核验的适配器提交；bootstrap 会克隆并 checkout 此提交到 runtime。
NAPCAT_ADAPTER_REPOSITORY=https://github.com/Mai-with-u/MaiBot-Napcat-Adapter.git
NAPCAT_ADAPTER_COMMIT=85bec0059afed0a7fd83b35ff06d393114562f42
